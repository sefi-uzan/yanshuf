{
  "name": "@yanshuf/desktop",
  "productName": "Yanshuf",
  "version": "1.0.0",
  "description": "macOS network proxy for inspecting HTTP/HTTPS traffic",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @yanshuf/mcp build && electron-forge start",
    "package": "pnpm --filter @yanshuf/mcp build && electron-forge package",
    "make": "pnpm --filter @yanshuf/mcp build && electron-forge make",
    "icons": "bash scripts/build-icons.sh",
    "release": "pnpm --filter @yanshuf/mcp build && electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "electron",
    "proxy",
    "mitm",
    "macos"
  ],
  "author": {
    "name": "Sefi",
    "email": "sefiuzan812@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@yanshuf/shared": "workspace:*",
    "@yanshuf/ui": "workspace:*",
    "http-mitm-proxy": "^1.1.0",
    "lucide-react": "^1.28.0",
    "node-forge": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "undici": "^8.9.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@yanshuf/eslint-config": "workspace:*",
    "@yanshuf/tailwind-config": "workspace:*",
    "@yanshuf/typescript-config": "workspace:*",
    "autoprefixer": "^10.5.4",
    "electron": "43.2.0",
    "eslint": "^9.39.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
